<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      Bukkit injects shared singletons (World, Service, Listener) by design.
      Defensive copies here would break identity semantics, so reference
      exposure warnings are not applicable.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Recording fakes in tests store values for later assertions. -->
    <Match>
        <Class name="~.*Test\$.*"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
    <!-- Bukkit getNearbyEntities is NotNull in stubs but null at runtime. -->
    <Match>
        <Class name="dev.mintychochip.archimedes.bukkit.BukkitCollisionObserverSampler"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
</FindBugsFilter>